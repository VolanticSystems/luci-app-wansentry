{
	"luci-app-wansentry": {
		"description": "Grant access to dual-WAN failover configuration",
		"read": {
			"file": {
				"/sbin/logread -l 200 -e mwan3": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"luci-rpc": [ "getNetworkDevices" ],
				"mwan3": [ "status" ],
				"network.interface": [ "dump" ],
				"uci": [ "changes", "get" ]
			},
			"uci": [ "mwan3", "network", "wansentry" ]
		},
		"write": {
			"ubus": {
				"luci": [ "setInitAction" ],
				"uci": [ "add", "apply", "confirm", "delete", "order", "rename", "set" ]
			},
			"uci": [ "mwan3", "wansentry" ]
		}
	}
}
