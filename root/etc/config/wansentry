# wansentry ships disabled. Nothing is written to /etc/config/mwan3 and the
# mwan3 service is left alone until the settings screen is applied once: the
# reconciler (/etc/init.d/wansentry) touches mwan3 only once wansentry owns its
# configuration, so a hand-configured mwan3 is never disturbed on install.

config wansentry 'main'
	# Master switch, effective only once wansentry owns the mwan3 config (has
	# applied at least once). 0 = wansentry's generated mwan3 interfaces are
	# written with `enabled 0` (mwan3 becomes inert and traffic falls through to
	# the normal routing table) and, if wansentry owns the config, the mwan3
	# service is stopped and disabled. While wansentry owns nothing, this switch
	# does not touch the mwan3 service at all.
	option enabled '0'

	# netifd interface names, as they appear in /etc/config/network.
	# Empty until the user picks them on the settings screen.
	option primary ''
	option backup ''

	# Display only; it does not affect the generated mwan3 configuration.
	# 0 = the settings screen offers only interfaces that have their own route
	#     off this router. 1 = every interface is listed, each labelled with why
	#     it is not normally offered.
	# Classification is by protocol, device and gateway, never by interface
	# name: an LTE stick, a tethered phone and a neighbour's wifi joined as a
	# station are all legitimate backups and none of them is called "wan". It
	# can still be wrong, most obviously for an ISP that delivers the uplink
	# over a tunnel, which is indistinguishable from a VPN from here. This
	# switch is the way past that, and the screen forces it on rather than let
	# a saved selection become unselectable.
	option show_all_interfaces '0'

	# Health-check targets. mwan3 pings these through each uplink's own
	# routing table. Two hosts on different operators is the point: one
	# ICMP-hostile or briefly unreachable target must not cause a failover,
	# so the generated config sets `reliability 1` (any one host answering
	# keeps the uplink up).
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'

	# Seconds between health checks.
	option interval '5'

	# Consecutive failed checks before an uplink is declared offline.
	# interval * down = worst-case detection time (default 15 s).
	option down '3'

	# Consecutive successful checks before an uplink is declared online
	# again. Deliberately higher than `down`: flapping back onto a shaky
	# primary is worse than staying on a working backup for another 15 s.
	option up '6'

	# 1 = traffic returns to the primary as soon as it recovers.
	# 0 = established connections stay pinned to the uplink they started on
	#     (mwan3 rule stickiness); new connections still prefer the primary.
	option failback '1'

	# 1 = flush the conntrack table on every uplink up/down transition, so
	# existing connections are not left pinned to a dead gateway.
	option flush_conntrack '1'
