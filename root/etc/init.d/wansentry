#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/STOP/USE_PROCD/PROG are read by
# /etc/rc.common, which sources this file; they are never referenced here.
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 VolanticSystems
#
# wansentry is a configuration generator, not a daemon. This init script exists
# only to reconcile the mwan3 SERVICE state (enabled/running) to the committed
# /etc/config/wansentry, and it is the reason the UI never touches init scripts
# from the browser.
#
# Why router-side and not from the LuCI apply handler:
#   /etc/init.d/mwan3 enable|disable writes /etc/rc.d symlinks, which UCI's
#   rollback snapshot does NOT cover (rollback only reverts /etc/config). Doing
#   the enable/disable in the browser, before or after the transactional commit,
#   can therefore leave the service state and the config disagreeing if the
#   apply is rolled back (a dropped connection during the confirm window). By
#   driving the service purely from the committed config -- on the wansentry
#   reload trigger, and again at boot -- the two can never diverge: a rollback
#   re-fires the trigger with the reverted config and the service follows it.

START=21
STOP=89
USE_PROCD=1

# True only when mwan3 is running AND has actually installed an IPv4 policy.
#
# `/etc/init.d/mwan3 running` is not sufficient on its own: mwan3 can report
# running while carrying no policy at all, in which case nothing is being
# steered and a failover would never happen. `mwan3 policies` reads the live
# firewall chains back, and prints one indented line per policy entry.
#
# Match ANY indented entry, not a percentage. This used to grep for
# '([0-9]+%)', which is printed only for a member that is currently ONLINE, and
# that is the inverse of the bug this function was written to catch. Measured
# on OpenWrt 25.12.5 / mwan3 2.12.0, all three states distinguished:
#
#   member online        " wan (100%)"   policy installed, armed
#   all uplinks offline  " default"      policy installed, armed, last_resort
#   no policy at all     (no indented line at all)      NOT armed
#
# The middle state is the whole point of `last_resort default`, and the old
# grep called it unarmed. reconcile() would then restart mwan3 on every reload
# trigger during a dual outage, and at boot whenever the uplinks were not up
# yet (START=21 runs before a WAN usually comes up) -- breaking this file's own
# promise that an ordinary settings edit never restarts an already-armed mwan3.
mwan3_armed() {
	/etc/init.d/mwan3 running >/dev/null 2>&1 || return 1
	mwan3 policies 2>/dev/null | grep -qE '^[[:space:]]+[^[:space:]]' || return 1
	return 0
}

reconcile() {
	local enabled owned managed foreign dump rc
	config_load wansentry
	config_get_bool enabled main enabled 0

	# Read /etc/config/mwan3 ONCE, and keep uci's exit status, because "there is
	# nothing here" and "I could not read it" are different facts that require
	# OPPOSITE actions and both produce empty output.
	#
	#   valid config, any content   rc=0
	#   valid but empty             rc=0, no lines   <- rolled-back first enable
	#   parse error                 rc=1, no lines   <- someone else's config!
	#   file absent                 rc=1, no lines
	#
	# (measured on OpenWrt 25.12.5, 2026-08-25.)
	#
	# Until then this function counted an unreadable config as an empty one and
	# fell through to the stop/disable branch below. A security audit found it
	# and it reproduced on hardware: a hand-configured mwan3 carrying no
	# wansentry marker at all, running with its boot symlink in place, was
	# stopped and disabled after a single unbalanced quote was appended to
	# /etc/config/mwan3. That is the package's one promise broken by the half of
	# it that runs as root, and it converts a recoverable config corruption into
	# a persistent one, because repairing the file does not restore the rc.d
	# symlink. Anyone able to write that file without being root could trigger it.
	#
	# Unknown is not permission. Touch nothing, and say so, because every service
	# call below is silenced and an operator would otherwise have no trace.
	dump=$(uci -q show mwan3 2>/dev/null)
	rc=$?
	if [ "$rc" -ne 0 ]; then
		logger -t wansentry -p daemon.warn \
			"/etc/config/mwan3 is missing or unreadable; leaving the mwan3 service untouched"
		return 0
	fi

	# Ownership gate, the service-side mirror of the generator's isOwned(). The
	# generator refuses to touch mwan3 CONFIG it did not write; the service must
	# refuse just as hard, or it stops a user's hand-configured mwan3 at boot
	# (enabled=0 is the shipped default), before the settings page has ever been
	# opened.
	#
	# owned   = sections the generator's isOwned() would claim: carrying
	#           `option wansentry '1'` OR living in the wansentry_ namespace.
	#           Counted by NAME and de-duplicated, because every generated
	#           section matches both tests and must not count twice.
	# managed = every mwan3 section except `globals`, which is mwan3's own
	#           infrastructure and belongs to neither side.
	# foreign = anything managed that wansentry did not write.
	#
	# If ANY foreign section exists, hand off entirely: that is a
	# hand-configured (or still-stock) mwan3 and none of it is ours to touch.
	#
	# Both counts previously disagreed with the generator, in the dangerous
	# direction. `managed` matched only interface/member/policy/rule, so an
	# mwan3 carrying a section of any OTHER type -- which audit() classifies as
	# foreign and refuses to write to -- was invisible here: measured
	# owned=0 managed=0 foreign=0 on a config holding `config notify`, which
	# takes the branch below and STOPS AND DISABLES a stranger's mwan3. That is
	# the one thing this package promises never to do. `owned` ignored the
	# wansentry_ namespace that isOwned() accepts, so a prefixed section without
	# the option counted as foreign here and as ours in the browser.
	owned=$(printf '%s\n' "$dump" \
		| sed -n "s/^mwan3\.\([^.]*\)\.wansentry='1'$/\1/p; s/^mwan3\.\(wansentry_[^.]*\)=.*/\1/p" \
		| sort -u | grep -c .)
	managed=$(printf '%s\n' "$dump" | grep -E "^mwan3\.[^.]+=" | grep -vc "=globals$")
	foreign=$(( managed - owned ))
	[ "$foreign" -gt 0 ] && return 0

	if [ "$enabled" = 1 ] && [ "$owned" -gt 0 ]; then
		# Own the enable symlink, then arm mwan3 only if it is not ALREADY
		# armed. "Armed" deliberately means more than "the init script says
		# running": see mwan3_armed().
		#
		# This used to be `running || start`, which is broken. Reproduced 2/2
		# on OpenWrt 25.12.5 with mwan3 2.12.0: after a disable/enable cycle,
		# `/etc/init.d/mwan3 start` returns success and `running` reports yes,
		# while mwan3 has installed NO policy at all. The failover screen then
		# says enabled and nothing is armed, which is the worst outcome this
		# package can produce, because it is only discovered during an outage.
		# `restart` performs the full teardown and setup and installs the
		# policy reliably.
		#
		# The original intent is preserved: an ordinary settings edit on an
		# already-armed mwan3 still does NOT restart it, so established
		# connections are not dropped for a threshold tweak. Only a genuinely
		# unarmed mwan3 is restarted.
		/etc/init.d/mwan3 enable 2>/dev/null
		mwan3_armed || /etc/init.d/mwan3 restart 2>/dev/null
	else
		# No foreign config to preserve, so reconciling the service down is safe
		# even when we own nothing. This is what catches a rolled-back FIRST
		# enable: the reverted config is empty or globals-only (owned=0), but the
		# apply window left mwan3 enabled and running, and rc.d symlinks are not
		# covered by UCI rollback. Without acting here that mwan3 would survive.
		/etc/init.d/mwan3 stop 2>/dev/null
		/etc/init.d/mwan3 disable 2>/dev/null
	fi
}

start_service() {
	reconcile
}

reload_service() {
	reconcile
}

service_triggers() {
	procd_add_reload_trigger wansentry
}
