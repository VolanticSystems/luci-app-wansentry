#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # START/STOP/USE_PROCD/PROG are read by
# /etc/rc.common, which sources this file; they are never referenced here.
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 VolanticSystems
#
# wansentry is a configuration generator, not a daemon. This init script exists
# only to reconcile the mwan3 SERVICE state (enabled/running) to the committed
# /etc/config/wansentry, and it is the reason the UI never touches init scripts
# from the browser.
#
# Why router-side and not from the LuCI apply handler:
#   /etc/init.d/mwan3 enable|disable writes /etc/rc.d symlinks, which UCI's
#   rollback snapshot does NOT cover (rollback only reverts /etc/config). Doing
#   the enable/disable in the browser, before or after the transactional commit,
#   can therefore leave the service state and the config disagreeing if the
#   apply is rolled back (a dropped connection during the confirm window). By
#   driving the service purely from the committed config -- on the wansentry
#   reload trigger, and again at boot -- the two can never diverge: a rollback
#   re-fires the trigger with the reverted config and the service follows it.

START=21
STOP=89
USE_PROCD=1

# True only when mwan3 is running AND has actually installed an IPv4 policy.
#
# `/etc/init.d/mwan3 running` is not sufficient on its own: mwan3 can report
# running while carrying no policy at all, in which case nothing is being
# steered and a failover would never happen. `mwan3 policies` prints one
# "name (N%)" line per member of each installed policy, read back out of the
# live firewall chains, so the absence of any percentage means no policy is
# installed and this router is not actually armed.
mwan3_armed() {
	/etc/init.d/mwan3 running >/dev/null 2>&1 || return 1
	mwan3 policies 2>/dev/null | grep -qE '\([0-9]+%\)' || return 1
	return 0
}

reconcile() {
	local enabled owned managed foreign
	config_load wansentry
	config_get_bool enabled main enabled 0

	# Ownership gate, the service-side mirror of the generator's isOwned(). The
	# generator refuses to touch mwan3 CONFIG it did not write; the service must
	# refuse just as hard, or it stops a user's hand-configured mwan3 at boot
	# (enabled=0 is the shipped default), before the settings page has ever been
	# opened.
	#
	# owned   = mwan3 sections carrying `option wansentry '1'` (set on every
	#           section the generator writes).
	# managed = mwan3 interface/member/policy/rule sections in total.
	# foreign = managed sections wansentry did not write.
	#
	# If ANY foreign managed section exists, hand off entirely: that is a
	# hand-configured (or still-stock) mwan3 and none of it is ours to touch.
	owned=$(uci -q show mwan3 | grep -c "\.wansentry='1'")
	managed=$(uci -q show mwan3 | grep -cE "=(interface|member|policy|rule)$")
	foreign=$(( managed - owned ))
	[ "$foreign" -gt 0 ] && return 0

	if [ "$enabled" = 1 ] && [ "$owned" -gt 0 ]; then
		# Own the enable symlink, then arm mwan3 only if it is not ALREADY
		# armed. "Armed" deliberately means more than "the init script says
		# running": see mwan3_armed().
		#
		# This used to be `running || start`, which is broken. Reproduced 2/2
		# on OpenWrt 25.12.5 with mwan3 2.12.0: after a disable/enable cycle,
		# `/etc/init.d/mwan3 start` returns success and `running` reports yes,
		# while mwan3 has installed NO policy at all. The failover screen then
		# says enabled and nothing is armed, which is the worst outcome this
		# package can produce, because it is only discovered during an outage.
		# `restart` performs the full teardown and setup and installs the
		# policy reliably.
		#
		# The original intent is preserved: an ordinary settings edit on an
		# already-armed mwan3 still does NOT restart it, so established
		# connections are not dropped for a threshold tweak. Only a genuinely
		# unarmed mwan3 is restarted.
		/etc/init.d/mwan3 enable 2>/dev/null
		mwan3_armed || /etc/init.d/mwan3 restart 2>/dev/null
	else
		# No foreign config to preserve, so reconciling the service down is safe
		# even when we own nothing. This is what catches a rolled-back FIRST
		# enable: the reverted config is empty or globals-only (owned=0), but the
		# apply window left mwan3 enabled and running, and rc.d symlinks are not
		# covered by UCI rollback. Without acting here that mwan3 would survive.
		/etc/init.d/mwan3 stop 2>/dev/null
		/etc/init.d/mwan3 disable 2>/dev/null
	fi
}

start_service() {
	reconcile
}

reload_service() {
	reconcile
}

service_triggers() {
	procd_add_reload_trigger wansentry
}
